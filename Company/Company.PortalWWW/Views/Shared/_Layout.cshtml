<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TurboMechanik</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Company.PortalWWW.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="topbar" aria-label="Glowna nawigacja">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">TM</span>
                TurboMechanik
            </a>

            <div class="nav-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">Wycena naprawy</a>
                <a asp-area="" asp-controller="Home" asp-action="Products">Warsztaty</a>
                <a asp-area="" asp-controller="Home" asp-action="Contact">Kontakt</a>
            </div>

            <a class="login-link" asp-area="" asp-controller="Home" asp-action="Products">Panel mechanika</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div>
            <strong>TurboMechanik</strong>
            <p>Szybka wycena kosztu naprawy i dopasowanie warsztatu do usterki.</p>
        </div>
        <span>Projekt MVP</span>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/dist/app.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
